            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 5 Activities -->
        <activity
            android:name=".pertemuan5.FifthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".pertemuan5.WebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 7 Activity -->
        <activity
            android:name=".pertemuan7.SeventhActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pertemuan 9 Activity -->
        <activity
            android:name=".pertemuan9.NinthActivity"
