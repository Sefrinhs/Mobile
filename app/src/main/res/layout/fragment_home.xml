<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.FragmentHome">

    <!-- Header Wave Background -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Daftar Pertemuan"
        app:titleTextColor="@android:color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Pertemuan:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

            <!-- Grid Layout Pertemuan -->
            <GridLayout
                android:id="@+id/gridPertemuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <!-- Pertemuan 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan2"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 2"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan3"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 3"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan4"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 4"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan5"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 5"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 7 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan7"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 7"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 9 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan9"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 9"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 10 Message -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan10"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 10 (Msg)"
                    android:textSize="13sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 10 More -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan10More"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 10 (More)"
                    android:textSize="13sp"
                    app:cornerRadius="12dp" />

                <!-- Pertemuan 11 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPertemuan11"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pertemuan 11"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

            </GridLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
